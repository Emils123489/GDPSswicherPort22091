+// True if `child` is strictly inside `parent` (not equal to it, and not a sibling
+// that merely shares a prefix like "gdpses2"). Both paths should be canonical.
+static bool isInsideDir(std::string_view child, std::string_view parent) {
+    while (!parent.empty() && (parent.back() == '/' || parent.back() == '\\')) {
+        parent.remove_suffix(1);
+    }
+    if (parent.empty() || child.size() <= parent.size() + 1) return false;
+    if (!child.starts_with(parent)) return false;
+    char sep = child[parent.size()];
+    return sep == '/' || sep == '\\';
+}

diff --git a/src/GameUrls.cpp b/src/GameUrls.cpp
new file mode 100644
index 0000000..ec0951f
--- /dev/null
+++ b/src/GameUrls.cpp
@@ -0,0 +1,128 @@
+#include "GameUrls.hpp"
+
+#include <Geode/platform/platform.hpp>
+#include <Geode/loader/Log.hpp>
+
+#include <array>
+#include <cstdint>
+#include <optional>
+#include <string_view>
+#include <vector>
+
+#if defined(GEODE_IS_WINDOWS)
+    #include <Windows.h>
+#elif defined(GEODE_IS_ANDROID)
+    #include <link.h>
+#elif defined(GEODE_IS_MACOS) || defined(GEODE_IS_IOS)
+    #include <mach-o/getsect.h>
+    #include <mach-o/loader.h>
+#endif
+
+#include "GameUrlsScan.hpp"
+
+namespace {
+    using Region = std::string_view;
+
+    // Collects the readable data regions of the main GD module.
+    std::vector<Region> gameDataRegions() {
+        std::vector<Region> regions;
+        auto const base = geode::base::get();
+        if (!base) return regions;
+
+#if defined(GEODE_IS_WINDOWS)
+        auto dos = reinterpret_cast<IMAGE_DOS_HEADER const*>(base);
+        if (dos->e_magic != IMAGE_DOS_SIGNATURE) return regions;
+        auto nt = reinterpret_cast<IMAGE_NT_HEADERS const*>(base + dos->e_lfanew);
+        if (nt->Signature != IMAGE_NT_SIGNATURE) return regions;
+        auto section = IMAGE_FIRST_SECTION(nt);
+        for (WORD i = 0; i < nt->FileHeader.NumberOfSections; ++i, ++section) {
+            auto const flags = section->Characteristics;
+            if (!(flags & IMAGE_SCN_MEM_READ)) continue;
+            if (flags & (IMAGE_SCN_MEM_EXECUTE | IMAGE_SCN_MEM_DISCARDABLE)) continue;
+            auto size = section->Misc.VirtualSize ? section->Misc.VirtualSize : section->SizeOfRawData;
+            regions.emplace_back(reinterpret_cast<char const*>(base + section->VirtualAddress), size);
+        }
+#elif defined(GEODE_IS_ANDROID)
+        struct Ctx {
+            std::uintptr_t base;
+            std::vector<Region>* out;
+        } ctx { base, &regions };
+        dl_iterate_phdr([](dl_phdr_info* info, size_t, void* data) -> int {
+            auto ctx = static_cast<Ctx*>(data);
+            bool isGame = false;
+            for (int i = 0; i < info->dlpi_phnum; ++i) {
+                auto const& ph = info->dlpi_phdr[i];
+                if (ph.p_type != PT_LOAD) continue;
+                auto start = info->dlpi_addr + ph.p_vaddr;
+                if (ctx->base >= start && ctx->base < start + ph.p_memsz) {
+                    isGame = true;
+                    break;
+                }
+            }
+            if (!isGame) return 0;
+            for (int i = 0; i < info->dlpi_phnum; ++i) {
+                auto const& ph = info->dlpi_phdr[i];
+                if (ph.p_type != PT_LOAD || !(ph.p_flags & PF_R)) continue;
+                // Only file-backed bytes; string literals never live in .bss
+                ctx->out->emplace_back(
+                    reinterpret_cast<char const*>(info->dlpi_addr + ph.p_vaddr), ph.p_filesz
+                );
+            }
+            return 1;
+        }, &ctx);
+#elif defined(GEODE_IS_MACOS) || defined(GEODE_IS_IOS)
+        auto header = reinterpret_cast<mach_header_64 const*>(base);
+        if (header->magic != MH_MAGIC_64) return regions;
+        for (auto [seg, sect] : std::array<std::pair<char const*, char const*>, 2> {{
+            {"__TEXT", "__cstring"},
+            {"__TEXT", "__const"},
+        }}) {
+            unsigned long size = 0;
+            auto data = getsectiondata(header, seg, sect, &size);
+            if (data && size) regions.emplace_back(reinterpret_cast<char const*>(data), size);
+        }
+#endif
+        return regions;
+    }
+}
+
+GameUrls::Result GameUrls::find() {
+    Result result;
+    auto regions = gameDataRegions();
+
+    for (auto const& region : regions) {
+        if (result.base.empty()) {
+            if (auto found = scan::findBaseUrl(region)) {
+                result.base = std::move(*found);
+                result.baseFromBinary = true;
+            }
+        }
+        if (result.secondary.empty()) {
+            if (auto found = scan::findSecondaryUrl(region)) {
+                result.secondary = std::move(*found);
+                result.secondaryFromBinary = true;
+            }
+        }
+        if (!result.base.empty() && !result.secondary.empty()) break;
+    }
+
+    if (result.base.empty()) {
+        geode::log::warn("Could not find the built-in server URL in the game binary, using the vanilla URL");
+        result.base = scan::VANILLA_BASE;
+    }
+    if (result.secondary.empty()) {
+        // A patched executable usually only changes the host, so derive it from the base URL
+        if (result.baseFromBinary && result.base.starts_with("https://")) {
+            result.secondary = "http://" + result.base.substr(8);
+        } else {
+            result.secondary = scan::VANILLA_SECONDARY;
+        }
+    }
+
+    geode::log::info(
+        "Built-in server URLs: {} ({}), {} ({})",
+        result.base, result.baseFromBinary ? "from binary" : "fallback",
+        result.secondary, result.secondaryFromBinary ? "from binary" : "fallback"
+    );
+    return result;
+}
diff --git a/src/GameUrls.hpp b/src/GameUrls.hpp
new file mode 100644
index 0000000..254fda2
--- /dev/null
+++ b/src/GameUrls.hpp
@@ -0,0 +1,23 @@
+#pragma once
+
+#include <string>
+
+// Locates the built-in server URLs inside the loaded Geometry Dash binary.
+//
+// Previous versions of Server API read these strings from hard-coded offsets,
+// which had to be re-found by hand for every GD update and every platform.
+// This scans the game's read-only data at runtime instead, so it keeps working
+// across GD versions and still picks up custom URLs in pre-patched GDPS
+// executables (which keep the endpoint names and only replace the host part).
+namespace GameUrls {
+    struct Result {
+        // e.g. "https://www.boomlings.com/database/"
+        std::string base;
+        // e.g. "http://www.boomlings.com/database/"
+        std::string secondary;
+        bool baseFromBinary = false;
+        bool secondaryFromBinary = false;
+    };
+
+    Result find();
+}
diff --git a/src/GameUrlsScan.hpp b/src/GameUrlsScan.hpp
new file mode 100644
index 0000000..522ec35
--- /dev/null
+++ b/src/GameUrlsScan.hpp
@@ -0,0 +1,115 @@
+#pragma once
+
+// Platform-independent string matching used by GameUrls.cpp.
+// Kept header-only and free of Geode includes so it can be unit-tested on any host.
+
+#include <cstddef>
+#include <optional>
+#include <string>
+#include <string_view>
+
+namespace GameUrls::scan {
+    inline constexpr std::string_view VANILLA_BASE = "https://www.boomlings.com/database/";
+    inline constexpr std::string_view VANILLA_SECONDARY = "http://www.boomlings.com/database/";
+
+    // Endpoints GD appends to the two URLs we look for. Patched GDPS executables
+    // replace the host part but keep these.
+    inline constexpr std::string_view BASE_ENDPOINT = "getGJLevelLists.php";
+    inline constexpr std::string_view SECONDARY_ENDPOINT = "getGJLevels21.php";
+
+    // base64("http") always starts with this
+    inline constexpr std::string_view BASE64_HTTP_PREFIX = "aHR0c";
+
+    inline constexpr std::size_t MAX_URL_LEN = 512;
+
+    inline bool isUrlChar(char c) {
+        return c > 0x20 && c < 0x7f;
+    }
+
+    inline bool looksLikeServerUrl(std::string_view url) {
+        if (!(url.starts_with("http://") || url.starts_with("https://"))) return false;
+        if (url.size() <= 8 || url.size() > MAX_URL_LEN) return false;
+        for (char c : url) {
+            if (!isUrlChar(c)) return false;
+        }
+        return url.ends_with('/');
+    }
+
+    // Finds a NUL-terminated "http(s)://.../getGJLevelLists.php" string and
+    // returns everything before the endpoint (with trailing slash).
+    // An https URL is preferred, since that is what vanilla GD uses for its main requests.
+    inline std::optional<std::string> findBaseUrl(std::string_view data) {
+        std::optional<std::string> httpFallback;
+        std::size_t pos = 0;
+        while ((pos = data.find(BASE_ENDPOINT, pos)) != std::string_view::npos) {
+            auto end = pos + BASE_ENDPOINT.size();
+            auto const hit = pos;
+            pos = end;
+            if (end < data.size() && data[end] != '\0') continue;
+
+            auto start = hit;
+            while (start > 0 && data[start - 1] != '\0' && hit - start < MAX_URL_LEN) {
+                --start;
+            }
+            auto url = data.substr(start, hit - start);
+            if (!looksLikeServerUrl(url)) continue;
+            if (url.starts_with("https://")) return std::string(url);
+            if (!httpFallback) httpFallback = std::string(url);
+        }
+        return httpFallback;
+    }
+
+    inline int base64Value(char c) {
+        if (c >= 'A' && c <= 'Z') return c - 'A';
+        if (c >= 'a' && c <= 'z') return c - 'a' + 26;
+        if (c >= '0' && c <= '9') return c - '0' + 52;
+        if (c == '+' || c == '-') return 62;
+        if (c == '/' || c == '_') return 63;
+        return -1;
+    }
+
+    // Accepts both the standard and URL-safe alphabets, padding optional.
+    inline std::optional<std::string> base64Decode(std::string_view in) {
+        while (!in.empty() && in.back() == '=') in.remove_suffix(1);
+        std::string out;
+        out.reserve(in.size() * 3 / 4);
+        unsigned int buffer = 0;
+        int bits = 0;
+        for (char c : in) {
+            int v = base64Value(c);
+            if (v < 0) return std::nullopt;
+            buffer = (buffer << 6) | static_cast<unsigned int>(v);
+            bits += 6;
+            if (bits >= 8) {
+                bits -= 8;
+                out.push_back(static_cast<char>((buffer >> bits) & 0xff));
+            }
+        }
+        return out;
+    }
+
+    // Finds the NUL-terminated base64 string that decodes to
+    // "http(s)://.../getGJLevels21.php" and returns the part before the endpoint.
+    inline std::optional<std::string> findSecondaryUrl(std::string_view data) {
+        std::size_t pos = 0;
+        while ((pos = data.find(BASE64_HTTP_PREFIX, pos)) != std::string_view::npos) {
+            auto const start = pos;
+            pos += BASE64_HTTP_PREFIX.size();
+            if (start > 0 && data[start - 1] != '\0') continue;
+
+            auto end = start;
+            while (end < data.size() && data[end] != '\0' && end - start < MAX_URL_LEN * 2) {
+                ++end;
+            }
+            if (end < data.size() && data[end] != '\0') continue;
+
+            auto decoded = base64Decode(data.substr(start, end - start));
+            if (!decoded || !decoded->ends_with(SECONDARY_ENDPOINT)) continue;
+            decoded->resize(decoded->size() - SECONDARY_ENDPOINT.size());
+            if (looksLikeServerUrl(*decoded)) {
+                return decoded;
+            }
+        }
+        return std::nullopt;
+    }
+}
